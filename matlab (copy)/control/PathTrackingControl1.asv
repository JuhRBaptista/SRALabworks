function PathTrackingControl1(tbot, params, path, handles, avoidance, mapParams, avoidParams, slam, savePath)
% PathTrackingControl1 - Tracks a path using waypoint navigation.
%
% FIXES vs. previous version
%   1. Relocalisation trigger changed from covariance-threshold to
%      beam-acceptance guard (mirrors demoNavigateWallVFH logic):
%        - sigma_pos > 0.01 fired constantly in open areas (legit variance).
%        - New trigger: nAcc/nValid stays below healthy thresholds for
%          divHoldSecs seconds AND the cooldown has elapsed.
%        - A hard cooldown (relocBlockSecs) prevents back-to-back relocs.
%   2. nAcc / nValid are now computed inside this loop (EKF correction
%      inlined) so the guard has the beam counts every iteration.
%      EKF.m is still called for predict; the correction is done here.
%   3. After a reloc, ekfIter is reset to 0 so the warm gate fires again,
%      giving the filter time to pull in before the tight gate takes over.

    if nargin < 5
        avoidance  = "none";
        mapParams  = [];  mapParams.map = [];
        avoidParams = [];
    end
    if nargin < 8, slam = false; end

    originalPts = path;
    useEKF = isfield(params, 'ekf') && params.ekf;

    if slam
        map = initMap(mapParams);
        mapParams.map = mapParams.initialProb;
    end

    target_index = 1;
    e_int        = 0;
    N            = size(path, 1);
    traj         = [];
    gtTraj       = [];
    r            = rateControl(params.rate);
    Cp           = diag(zeros(1, 3));
    ekfIter      = 0;

    % ------------------------------------------------------------------
    % EKF measurement-noise parameters (same as EKF.m)
    % ------------------------------------------------------------------
    nBeams        = 120;
    sigma_R_rel   = 0.035;
    sigma_R_base  = 0.030;
    minApplyBeams = 8;
    warmIters     = 20;
    e_normal      = 2.5;
    e_warm        = 4.0;

    % ------------------------------------------------------------------
    % Beam-acceptance divergence guard parameters
    % ------------------------------------------------------------------
    accGoodCount  = 12;      % "healthy" accepted-beam count (absolute)
    accGoodFrac   = 0.35;    % "healthy" accepted / valid fraction
    divHoldSecs   = 3.0;     % sustained low-acceptance before declaring divergence
    relocCoolSecs = 8.0;     % minimum seconds between two re-localizations
    lowAccSince   = inf;     % timestamp when beam acceptance first went low
    lastRelocT    = -inf;    % timestamp of last successful re-localization

    if useEKF
        tbot.initEncoders();

        if params.estimatePose
            if isfield(params, 'p0') && ~isempty(params.p0)
                p  = params.p0(:);
                Cp = params.Sigma0;
                [p, path] = getRoute(tbot, originalPts, mapParams, p);
            else
                [p, path] = getRoute(tbot, originalPts, mapParams);
                Cp = diag([0.1, 0.1, 0.1]);
            end
            N = size(path, 1);
        else
            [px, py, pth, ~] = tbot.readPose();
            p  = [px; py; normalizeAngle(pth)];
            Cp = diag([0.01, 0.01, 0.001]);
        end

        gzSub     = rossubscriber('/gazebo/model_states');
        robotName = 'turtlebot3';
    end

    % ------------------------------------------------------------------
    % Main loop timer (needed for the time-based divergence guard)
    % ------------------------------------------------------------------
    tic;

    for t = 0 : params.dt : params.T
        t_now = toc;

        [~, data] = tbot.readLidar();

        if useEKF
            ekfIter = ekfIter + 1;
            mapParams.ekfIter = ekfIter;

            noise_std = 0.002;
            [dsr, dsl, ~, ~] = tbot.readEncodersWithNoise(noise_std);

            % --- EKF predict (odometry) ---
            [p, Cp] = ekfPredict(p, Cp, [dsr, dsl]);

         
            pose.x     = p(1);
            pose.y     = p(2);
            pose.theta = p(3);

            [gt_x, gt_y, gt_theta] = readGroundTruth(gzSub, robotName);
            gtTraj = [gtTraj; gt_x, gt_y, gt_theta];

            % --------------------------------------------------------------
            % Beam-acceptance divergence guard
            % --------------------------------------------------------------
            % "Healthy" = warmup period, OR no valid beams at all (robot in
            % open space, walls out of range - not a sign of divergence), OR
            % enough beams accepted in both absolute and relative terms.
            accHealthy = (ekfIter <= warmIters) || (nValid == 0) || ...
                         (nAcc >= accGoodCount && nAcc >= accGoodFrac * nValid);

            if accHealthy
                lowAccSince = inf;          % reset the crash timer
            elseif isinf(lowAccSince)
                lowAccSince = t_now;        % start timing the crash
            end

            beamDiverged = (t_now - lowAccSince) > divHoldSecs && ...
                           (t_now - lastRelocT)  > relocCoolSecs;

            if beamDiverged
                fprintf('[RELOC] Beam acceptance crashed (%d/%d valid) for >%.0fs - re-localising...\n', ...
                        nAcc, nValid, divHoldSecs);

                tbot.setVelocity(0, 0);

                % Fresh global fix with retry
                sensor_offset = [-0.0305; 0];
                loc_retries   = 4;
                loc_score_max = 0.12;

                bestResidual = inf;  pBest = p;
                for attempt = 1:loc_retries
                    [~, lddata0, ~] = tbot.readLidar();
                    [p_try, s_try]  = globalLocalize(lddata0, mapParams.map, mapParams.scale, ...
                                                     mapParams.origin, mapParams.maxRange, ...
                                                     sensor_offset);
                    if s_try < bestResidual
                        bestResidual = s_try;
                        pBest        = p_try;
                    end
                    if bestResidual <= loc_score_max, break; end
                    fprintf('  attempt %d: residual=%.3f m (need <= %.3f) - retrying\n', ...
                            attempt, s_try, loc_score_max);
                end

                fprintf('=> pose est: [%.2f m  %.2f m  %.1f deg]  residual=%.3f m\n\n', ...
                        pBest(1), pBest(2), rad2deg(pBest(3)), bestResidual);

                if bestResidual > loc_score_max
                    warning('High localisation residual (%.3f m). Covariance inflated.', bestResidual);
                end

                p  = pBest;
                conf = min(1, bestResidual / loc_score_max);
                Cp   = diag([0.10, 0.10, deg2rad(12)].^2) .* (1 + 4*conf);

                % Re-plan from recovered pose
                [p, path]    = getRoute(tbot, originalPts, mapParams, p);
                N            = size(path, 1);
                target_index = 1;
                e_int        = 0;

                % Reset EKF warm-up so the loose gate fires again
                ekfIter  = 0;

                % Reset guard state
                lowAccSince = inf;
                lastRelocT  = t_now;

                fprintf('[RELOC] Route re-traced with %d waypoints.\n', N);
                pause(2);
                continue;
            end
            % --------------------------------------------------------------

        else
            [pose.x, pose.y, pose.theta, ~] = tbot.readPose();
            pose.theta = normalizeAngle(pose.theta);
        end

        traj = [traj; pose.x, pose.y];

        waypoint.x = path(target_index, 1);
        waypoint.y = path(target_index, 2);

        if slam
            idx_occ  = tbot.getInRangeLidarDataIdx(data);
            idx_free = tbot.getOutRangeLidarDataIdx(data);
            [map, ~] = mapUpdate(map, data, idx_occ, idx_free, pose, mapParams);
            mapParams.map = map.prob;
        end

        [target, h, alpha] = computeTarget(pose, waypoint, avoidance, mapParams, avoidParams);

        distance = getEuclidianDistance(pose, waypoint);
        e        = getEuclidianDistance(pose, target) - params.distance;
        phi      = getAngularError(pose, target);

        e_int           = e_int + e * params.dt;
        linearVelocity  = params.kv * e + params.ki * e_int;
        angularVelocity = params.ks * phi;

        linearVelocity  = max(min(linearVelocity,  params.vMax), 0);
        angularVelocity = max(min(angularVelocity,  params.wMax), -params.wMax);

        tbot.setVelocity(linearVelocity, angularVelocity);

        if distance < params.toleranceError && target_index < N
            target_index = target_index + 1;
            e_int = 0;
        end

        if target_index >= N && distance < params.finalToleranceError
            break;
        end

        updatePlot(handles, traj, gtTraj, pose, target, path, h, alpha, Cp, mapParams.map);
        waitfor(r);
    end

    tbot.setVelocity(0, 0);
    save("../data/noCorrected_trajs", "traj", "gtTraj");

    if slam
        saveResults(map.prob, savePath);
    end
end

% -------------------------------------------------------------------------

function [target, h, alpha] = computeTarget(pose, waypoint, avoidance, mapParams, avoidParams)
    h = 0; alpha = 0;
    switch avoidance
        case "vff"
            target = computeTargetVFF(pose, waypoint, mapParams, avoidParams);
        case "vfh"
            alpha  = avoidParams.sectorWidth;
            [target, h] = computeTargetVFH(pose, waypoint, mapParams, avoidParams);
        otherwise
            target = waypoint;
    end
end

function target = computeTargetVFF(pose, waypoint, mapParams, avoidParams)
    [Fa, Fr] = VFF([pose.x, pose.y], [waypoint.x, waypoint.y], mapParams, avoidParams);
    F  = Fa + Fr;  Fn = norm(F);
    if Fn < 1e-6
        target = pose;
    else
        dir_hat  = F / Fn;
        dist     = getEuclidianDistance(pose, waypoint);
        L        = min(1, dist);
        target.x = pose.x + L * dir_hat(1);
        target.y = pose.y + L * dir_hat(2);
    end
end

function [target, h] = computeTargetVFH(pose, waypoint, mapParams, avoidParams)
    [steerAngle, h] = VFH([pose.x, pose.y, pose.theta], [waypoint.x, waypoint.y], ...
                          mapParams, avoidParams);
    if isnan(steerAngle)
        target = pose; return;
    end
    dist     = getEuclidianDistance(pose, waypoint);
    L        = min(1, dist);
    target.x = pose.x + L * cos(steerAngle);
    target.y = pose.y + L * sin(steerAngle);
end

function map = initMap(mapParams)
    map.prob    = mapParams.initialProb;
    map.logOdds = mapParams.initialLogOdds;
end

function saveResults(mapProb, savePath)
    imgData = uint8(flipud(1 - mapProb) * 255);
    imwrite(imgData, [savePath, '.png']);
    save([savePath, '.mat'], 'mapProb');
end