function [p, Cp] = EKF(dsr, dsl, p, Cp, data, params)

    u = [dsr, dsl];

    % Prediction step
    [p, Cp] = ekfPredict(p, Cp, u);

    V = [];        % Innovation vector
    G = [];        % Stacked Jacobians
    R = [];        % Block-diagonal measurement covariance

    for i = 1:5:360
        % LiDAR angle relative to robot frame
        angle = deg2rad(i - 1);
        o = data.Ranges(i);

        if isinf(o) || o <= 0
            continue;
        end

        r_i = (0.035 * distance)^2;

        % Predicted observation and Jacobian
        o_hat = g(p, params.map, angle, params);

        % Innovation
        v_i = o - o_hat;
        
        % Innovation covariance
        s_i = Jz * Cp * Jz' + r_i;

        % Mahalanobis validation gate
        e = 2;
        if v_i*(s_i)*s_i' <= e^2
            V = [V; v_i];
            G = [G; Jz];
            R = [R; r_i];

        end
    end

    % Correction step
    [p, Cp] = ekfUpdate(p, Cp, V, G, R_mat);

end